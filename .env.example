# Set a long, unique administrator password. No default password is provided.
ADMIN_PASSWORD=
# Optional random signing secret. Generate with: openssl rand -hex 32
# Changing this secret or the password expires existing admin sessions.
ADMIN_SESSION_SECRET=
# Optional persistent directory for registrations; defaults to .data in the project.
REGISTRATIONS_DATA_DIR=
# Optional persistent directory for per-event program speaker details; defaults to .data.
PROGRAM_SPEAKERS_DATA_DIR=
# Optional directory for partner logo settings; defaults to .data.
PARTNERS_DATA_DIR=
# Optional directory for prediction texts; defaults to .data.
PREDICTIONS_DATA_DIR=
# Yandex Wiki: OAuth token with wiki:read and wiki:write permissions.
# Recommended: store the token in a private text file outside Git and public/.
YANDEX_WIKI_OAUTH_TOKEN_FILE=
# Alternatively set the token in the server environment; never NEXT_PUBLIC_.
YANDEX_WIKI_OAUTH_TOKEN=
YANDEX_WIKI_ORG_ID=
# cloud uses X-Cloud-Org-Id; 360 uses X-Org-Id.
YANDEX_WIKI_ORG_TYPE=cloud
# UUID of the dynamic grid, not the page ID.
YANDEX_WIKI_GRID_ID=
# Optional link to the page containing the grid (https://wiki.yandex.ru/...).
YANDEX_WIKI_PAGE_URL=
